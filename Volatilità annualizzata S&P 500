    "import yfinance as yf\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Download dati S&P 500 disattivando il MultiIndex\n",
    "data = yf.download(\"^GSPC\", start=\"2023-01-01\", multi_level_index=False)['Close']\n",
    "\n",
    "# Calcolo rendimenti logaritmici e volatilità\n",
    "log_returns = np.log(data / data.shift(1)).dropna()\n",
    "volatility = log_returns.std() * np.sqrt(252)\n",
    "\n",
    "# Estrazione del valore numerico scalare per la stampa\n",
    "vol_value = volatility.item() if hasattr(volatility, 'item') else float(volatility)\n",
    "print(f\"Volatilità Annualizzata S&P 500: {vol_value:.2%}\")\n",
    "\n",
    "# Grafico dei rendimenti\n",
    "log_returns.plot(title=\"Rendimenti S&P 500\", figsize=(10, 4))\n",
    "plt.show()"
   ]
